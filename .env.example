# Zyphuel Fuel Delivery - Environment Configuration Example
# Official Pakistan Standard Time (PKT)
VITE_BUSINESS_HOURS_TIMEZONE=Asia/Karachi

# Doorstep Fuel Order Intake Daily Schedule (08:00 to 22:00 PKT)
VITE_ORDER_INTAKE_START=08:00
VITE_ORDER_INTAKE_END=22:00

# Automated Verification & QA Sandbox Checkout Path
VITE_ENABLE_QA_ORDER_BYPASS=true

# Explicitly disable cutoff gate (used in test/staging/CI environments)
# Set to "true" in test / staging / CI to allow 24/7 order flow testing
VITE_DISABLE_ORDER_CUTOFF=false
