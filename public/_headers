/*
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

/404.html
  X-Robots-Tag: noindex, follow
  Cache-Control: no-cache, no-store, must-revalidate

# Prerendered HTML: keep the document instantly revalidatable in the browser but let the
# CDN hold it for 10 minutes (stale-while-revalidate for a day). Every request previously
# answered `max-age=0, must-revalidate` and the edge forwarded to origin each time, which is
# where the 640-810 ms TTFB Lighthouse reported came from.
/
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/order/
  Link: <https://zyphuel.netlify.app/order/>; rel="canonical"
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/download/
  Link: <https://zyphuel.netlify.app/download/>; rel="canonical"
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/services/
  Link: <https://zyphuel.netlify.app/services/>; rel="canonical"
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/ezgif-2f1a39c97e5b173b-jpg/*
  Cache-Control: public, max-age=31536000, immutable

# Scroll-animation frame sequences (1,200+ JPEGs across the 4 canvas heroes).
# Without these rules they inherited the global `max-age=0, must-revalidate`
# from netlify.toml and every page view revalidated hundreds of frames.
/services-hero-frames/*
  Cache-Control: public, max-age=31536000, immutable

/services-section3-frames/*
  Cache-Control: public, max-age=31536000, immutable

/app-hero-frames/*
  Cache-Control: public, max-age=31536000, immutable

/app-section3-frames/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/APK/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Disposition: attachment; filename="Zyphuel.apk"

/IOS/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Disposition: attachment; filename="Zyphuel.ipa"
  X-Content-Type-Options: nosniff

/sitemap.xml
  Cache-Control: public, max-age=86400

/feed.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400

/llms-full.txt
  Cache-Control: public, max-age=86400

/ads.txt
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400
